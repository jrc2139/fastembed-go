# FastEmbed Go Environment Configuration
# Copy this file to .env and adjust paths as needed

# Path to ONNX Runtime shared library
# Required if auto-detection fails or for custom ONNX Runtime installations

# Linux example (using local copy):
ONNX_PATH="${PWD}/onnxruntime/lib/libonnxruntime.so"

# Linux example (system-wide install):
# ONNX_PATH="/usr/local/lib/libonnxruntime.so"

# macOS example:
# ONNX_PATH="${PWD}/onnxruntime/lib/libonnxruntime.dylib"

# macOS system example:
# ONNX_PATH="/usr/local/lib/libonnxruntime.dylib"

# Windows example:
# ONNX_PATH="${PWD}/onnxruntime/lib/onnxruntime.dll"

# Optional: HuggingFace endpoint for mirrors (China, etc.)
# HF_ENDPOINT="https://hf-mirror.com"

# Optional: Custom cache directory for downloaded models
# Priority: FASTEMBED_CACHE_DIR > HF_HOME/fastembed > ~/.cache/huggingface/fastembed
# FASTEMBED_CACHE_DIR="${PWD}/.fastembed_cache"

# HuggingFace home directory (models cached in $HF_HOME/fastembed)
# If set, models are shared with other HF-based tools
# HF_HOME="${HOME}/.cache/huggingface"
